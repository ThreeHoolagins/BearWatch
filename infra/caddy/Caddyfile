# Single origin: SPA, API, auth and media all under one host, so the session
# cookie can be HttpOnly + SameSite=Lax with no CORS.
{$APP_HOST:localhost} {
	encode zstd gzip

	# Photo uploads: 12 MB photo plus form fields. Everything else stays small.
	handle /api/posts {
		request_body {
			max_size 13MB
		}
		reverse_proxy web:3000
	}
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy web:3000
	}
	handle /auth/* {
		reverse_proxy web:3000
	}
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
