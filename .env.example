# Copy to .env and fill in. Never commit .env.

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bearwatch
MYSQL_USER=bearwatch
MYSQL_PASSWORD=change-me

# --- Rails ---
# Production only (uncomment). Generate with: docker compose run --rm web bin/rails secret
# SECRET_KEY_BASE=
# Public hostname Caddy serves (e.g. bearwatch.example.com). "localhost" for local testing.
APP_HOST=localhost

# --- SSO ---
# Google: https://console.cloud.google.com/apis/credentials (OAuth client, "Web application")
# GitHub: https://github.com/settings/developers (OAuth App)
# Redirect URIs to register:
#   dev:  http://localhost:5173/auth/google_oauth2/callback  and  http://localhost:5173/auth/github/callback
#   prod: https://APP_HOST/auth/google_oauth2/callback      and  https://APP_HOST/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Photos ---
# Minimum bear confidence from the detector (0-1). Tune with detector/tests/evaluate.py.
BEAR_CONFIDENCE_THRESHOLD=0.85
# Place search uses OpenStreetMap's Nominatim, which asks for a contact in the
# User-Agent. An email address or your site's URL.
GEOCODER_CONTACT=

# --- Cloudflare R2 photo storage (see docs/r2-setup.md) ---
# STORAGE_BACKEND=r2 stores published photos in R2; anything else uses local disk.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Optional: a Cloudflare API token with "Account Analytics: Read" so photo
# views (reads) count toward the cap too. Without it only storage and writes are capped.
R2_ANALYTICS_TOKEN=
# Free-tier caps. Uploads pause ("Oops! Ran out of honey") before any is crossed.
# Defaults: R2_STORAGE_LIMIT_GB=9.5, R2_CLASS_A_LIMIT=950000, R2_CLASS_B_LIMIT=9500000

# --- Alert email (sent once a month if uploads pause) ---
ALERT_EMAIL=
# SMTP. For Gmail: smtp.gmail.com, port 587, your address, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
